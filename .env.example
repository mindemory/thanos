# Copy to .env.local and fill in what you need. A local copy needs none of these: it keeps its
# database in .thanos/ and shows sign-in links on the page. A hosted one needs the first five.

# Postgres: Neon, Supabase (its transaction pooler string, port 6543) or the university's own.
# Unset, Thanos runs on PGlite in .thanos/ on this computer.
DATABASE_URL=

# Where this Thanos lives, for links in emails and invites. On Vercel its production address
# is used when this is unset.
THANOS_URL=

# Who runs it, comma-separated emails: they can start labs, and open one only while its admins
# let them in (a week at a time, from the lab's Settings).
THANOS_ADMINS=

# Email for sign-in links and "your question was answered", through Resend
# (https://resend.com), from an address on a domain verified there.
RESEND_API_KEY=
THANOS_MAIL_FROM=Thanos <thanos@example.edu>

# Optional: a GitHub token, so the Code page isn't held to GitHub's 60 requests an hour. It still
# lists public repositories only, so no lab sees another's private code.
GITHUB_TOKEN=

# Optional: who to ask about a lab's data, shown on /privacy.
THANOS_CONTACT=

# Optional: how many database connections each server keeps (default 3), for a database that
# allows few.
THANOS_DB_POOL=

# Optional, local copy only: where PGlite keeps its files (default .thanos/db).
# THANOS_LOCAL=1 makes a production build without DATABASE_URL behave as a local copy; without it,
# only `npm run dev` shows sign-in links on the page.
THANOS_LOCAL=
THANOS_DATA_DIR=
