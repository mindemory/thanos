# Copy to .env.local and fill in what you need. A local copy needs none of these: it keeps its
# database in .thanos/ and shows sign-in links on the page. A hosted one needs the first five.

# Postgres: Neon, Supabase (its transaction pooler string, port 6543) or the university's own.
# Unset, Thanos runs on PGlite in .thanos/ on this computer.
DATABASE_URL=

# Where this Thanos lives, for links in emails and invites. On Vercel its production address
# is used when this is unset.
THANOS_URL=

# Who runs it, comma-separated emails: they can start labs and open any lab as its admin.
THANOS_ADMINS=

# Email for sign-in links and "your question was answered", through Resend
# (https://resend.com), from an address on a domain verified there.
RESEND_API_KEY=
THANOS_MAIL_FROM=Thanos <thanos@example.edu>

# Optional: a GitHub token, so the Code page shows private repositories it can see and isn't
# held to GitHub's 60 requests an hour.
GITHUB_TOKEN=

# Optional, local copy only: where PGlite keeps its files (default .thanos/db).
THANOS_DATA_DIR=
